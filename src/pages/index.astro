---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
import Education from "../components/Education.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} - {siteConfig.title}</title>

    <!-- OG / Twitter -->
    <meta property="og:title" content={`${siteConfig.name} - ${siteConfig.title}`} />
    <meta property="og:description" content={siteConfig.description} />
    <meta property="og:image" content="https://raquel-montes.cofoundy.dev/og.jpg" />
    <meta property="og:url" content="https://raquel-montes.cofoundy.dev/" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://raquel-montes.cofoundy.dev/og.jpg" />

    <!-- SEO -->
    <meta name="keywords" content="Raquel Montes Bravo, abogada, derecho informático, ciberseguridad, derecho constitucional, Lima, Perú, conciliadora extrajudicial" />
    <link rel="canonical" href="https://raquel-montes.cofoundy.dev/" />

    <!-- Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Attorney",
      "name": "Raquel Prisca Montes Bravo",
      "jobTitle": "Abogada — Derecho Informático & Ciberseguridad",
      "url": "https://raquel-montes.cofoundy.dev",
      "image": "https://raquel-montes.cofoundy.dev/profile.png",
      "address": { "@type": "PostalAddress", "addressLocality": "Lima", "addressCountry": "PE" },
      "alumniOf": [
        { "@type": "CollegeOrUniversity", "name": "Universidad San Martín de Porres" },
        { "@type": "CollegeOrUniversity", "name": "Universidad Nacional Hermilio Valdizán" }
      ],
      "knowsAbout": ["Derecho Informático", "Ciberseguridad", "Derecho Constitucional", "Derecho Civil", "Derecho Laboral", "Conciliación Extrajudicial"]
    })} />
  </head>
  <body>
    <Header />
    <section>
      <Hero />
      <About />
      <Projects />
      <Experience />
      <Education />
    </section>
    <Footer />
  </body>
</html>
